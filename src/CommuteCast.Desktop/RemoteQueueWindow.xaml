<Window x:Class="CommuteCast.Desktop.RemoteQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommuteCast · Remote queue" Width="860" Height="700" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="WindowLoaded" Closed="WindowClosed">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Expander x:Name="SettingsPanel" Header="Shared folder and worker settings" Margin="0,0,0,14">
            <ScrollViewer MaxHeight="235" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
                <Label Content="Shared OneDrive folder" Target="{Binding ElementName=FolderInput}"/>
                <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse"/><TextBox x:Name="FolderInput" MinWidth="260"/></DockPanel>
                <CheckBox x:Name="EnableWorker" Content="Let this PC generate remote jobs" Margin="0,10,0,4"/>
                <Label Content="Worker name" Target="{Binding ElementName=WorkerName}"/>
                <TextBox x:Name="WorkerName" MaxLength="120"/>
                <Label Content="Fallback preset names in order (one per line)" Target="{Binding ElementName=FallbackInput}"/>
                <TextBox x:Name="FallbackInput" AcceptsReturn="True" MinHeight="48" MaxHeight="84" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="PresetHint" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <CheckBox x:Name="AllowHosted" Content="Allow this worker to send narration text to hosted speech providers" Margin="0,10,0,4"/>
                <Button Content="Save remote settings" Click="SaveRemoteSettings" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel></ScrollViewer>
        </Expander>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Label Content="Available workers" Target="{Binding ElementName=Workers}"/>
            <DockPanel>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send current narration" Click="SendDraft" IsEnabled="False"/>
                <ComboBox x:Name="Workers" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="WorkerSelectionChanged" MinWidth="210"/>
            </DockPanel>
            <TextBlock x:Name="RosterSummary" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="JobList" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="JobSelectionChanged"
                      SelectedValuePath="Id" AutomationProperties.Name="Remote narration library" MinHeight="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Narration" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StateLabel}" Width="180"/>
                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="190"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="JobDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="100" Margin="0,8,0,0" AutomationProperties.Name="Remote narration details"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <WrapPanel>
                <Button x:Name="PlayButton" Content="Open finished MP3" Click="OpenMp3" IsEnabled="False"/>
                <Button x:Name="DiagnosticsButton" Content="Copy speech diagnostics" Click="CopyDiagnostics" IsEnabled="False"/>
                <Button x:Name="RetryButton" Content="Retry on this worker" Click="RetryOnWorker" IsEnabled="False"/>
                <Button Content="Open listening folder" Click="OpenListeningFolder"/>
            </WrapPanel>
            <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>
