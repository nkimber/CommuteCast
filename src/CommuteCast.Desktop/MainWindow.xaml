<Window x:Class="CommuteCast.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommuteCast" Width="1380" Height="900" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="14" Loaded="WindowLoaded" Closing="WindowClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible"/>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="SelectableDetails" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SidebarInk}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,2,0,2"/></Style>
    </Window.Resources>
    <Window.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding QueueCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="compose"/></Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}"><Grid Margin="20,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <Border Width="42" Height="42" Background="#CF704A" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Rectangle Width="3" Height="12" Fill="White" Margin="2"/><Rectangle Width="3" Height="23" Fill="White" Margin="2"/><Rectangle Width="3" Height="17" Fill="White" Margin="2"/><Rectangle Width="3" Height="9" Fill="White" Margin="2"/></StackPanel></Border>
                <TextBlock Text="CommuteCast" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource SidebarInk}"/><TextBlock Text="Good reading. On the road." FontSize="11" Foreground="{DynamicResource SidebarMuted}" Margin="0,7,0,30"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="-10,0,-10,0"><Button Content="＋   New narration" Style="{StaticResource Nav}" Command="{Binding NavigateCommand}" CommandParameter="compose" AutomationProperties.Name="New narration"/><Button Content="♫    Your library" Style="{StaticResource Nav}" Command="{Binding NavigateCommand}" CommandParameter="library" AutomationProperties.Name="Your library"/><Button Content="⚙    Settings" Style="{StaticResource Nav}" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="Settings"/></StackPanel>
            <StackPanel Grid.Row="3"><Border BorderBrush="#48504A" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="LOCAL BY DESIGN" Foreground="{DynamicResource SidebarInk}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Speech stays on this laptop.&#10;Only finished audio is exported." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SidebarMuted}" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="CommuteCast 0.1 · Windows" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="0,22,0,0"/></StackPanel>
        </Grid></Border>
        <Grid Grid.Column="1" Margin="34,26,34,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR COMMUTE, WELL SPENT" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock Text="{Binding PageHeading}" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center" MaxWidth="280"><TextBlock Text="{Binding ServiceStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border></Grid>
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Error}" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,18" Visibility="{Binding HasAttention, Converter={StaticResource BoolVisible}}" AutomationProperties.Name="Attention required" AutomationProperties.LiveSetting="Assertive">
                <StackPanel>
                    <TextBlock Text="{Binding AttentionHeading}" Foreground="{DynamicResource Error}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,12"><TextBlock Text="{Binding AttentionMessage}" TextWrapping="Wrap"/></ScrollViewer>
                    <WrapPanel><Button Content="View saved narrations" Command="{Binding ViewAttentionCommand}"/><Button Content="Start / repair speech services" Command="{Binding RepairSpeechCommand}"/><Button Content="Check speech readiness" Command="{Binding ReadinessCommand}"/><Button Content="Open setup checks" Command="{Binding NavigateCommand}" CommandParameter="settings"/></WrapPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Visibility="{Binding IsCompose, Converter={StaticResource BoolVisible}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Turn something worth reading into something worth hearing." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,16"><Label Target="{Binding ElementName=TitleInput}" Content="TITLE" FontSize="11" FontWeight="SemiBold" Padding="0,0,0,7"/><TextBox x:Name="TitleInput" Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="17" MaxLength="150" AutomationProperties.Name="Narration title"/></StackPanel>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,8"><TextBlock Text="YOUR TEXT" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding CharacterCount}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid><TextBox x:Name="SourceInput" Grid.Row="1" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" Padding="20" SpellCheck.IsEnabled="False" AutomationProperties.Name="Paste the text to narrate" SelectionChanged="SourceSelectionChanged"/><TextBlock Grid.Row="2" Text="Paste a response, an article, or a plan. Your draft is saved on this laptop." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/></Grid>
                    <Grid Grid.Row="3" Margin="0,20,0,0"><Button Content="Review spoken text" Command="{Binding ReviewCommand}" HorizontalAlignment="Left"/><Button Content="Queue narration  →" Command="{Binding QueueCommand}" HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Padding="24,12" ToolTip="Queue narration (Ctrl+Enter)"/></Grid>
                </Grid>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="10" Padding="20" Margin="0,0,0,16" Visibility="{Binding HasLatestJob, Converter={StaticResource BoolVisible}}">
                        <StackPanel>
                            <TextBlock Text="LATEST SAVED NARRATION" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LatestJob.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,10"/>
                            <TextBlock Text="{Binding LatestJob.Status}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar Height="4" Value="{Binding LatestJob.Progress, Mode=OneWay}" Maximum="{Binding LatestJob.ChunkTotal}" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Tint}"/>
                            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding LatestJob.IsWorking, Converter={StaticResource BoolVisible}}" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Tint}" AutomationProperties.Name="Narration work in progress"/>
                            <TextBlock Text="{Binding LatestJob.Guidance}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/>
                            <TextBlock Text="{Binding LatestJob.Error}" TextWrapping="Wrap" Foreground="{DynamicResource Error}" Margin="0,8,0,0" FontSize="12"/>
                            <Button Content="View progress in library →" Command="{Binding ViewLatestCommand}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel>
                    <TextBlock Text="Make it yours" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><Label Content="Speech engine" Target="{Binding ElementName=EngineInput}" Padding="0,0,0,6"/><ComboBox x:Name="EngineInput" ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}" AutomationProperties.Name="Speech engine"/>
                    <Label Content="Voice" Target="{Binding ElementName=VoiceInput}" Padding="0,16,0,6"/><ComboBox x:Name="VoiceInput" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" AutomationProperties.Name="Narration voice"/><Button Content="▶  Play standard sample" Command="{Binding AuditionCommand}" CommandParameter="sample" Margin="0,12,0,0" AutomationProperties.Name="Play standard voice audition"/><Button Content="▶  Play selected text" Command="{Binding AuditionCommand}" CommandParameter="selection" IsEnabled="{Binding HasAuditionSelection}" Margin="0,8,0,0" AutomationProperties.Name="Play selected text with current voice"/><TextBlock Text="{Binding AuditionSelectionSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="■  Stop audition" Command="{Binding StopCommand}" Margin="0,8,0,0" AutomationProperties.Name="Stop audition generation and playback"/>
                    <Grid Margin="0,22,0,8"><TextBlock Text="Speaking pace"/><TextBlock Text="{Binding SpeedLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid><Slider Minimum="0.7" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Speed}" AutomationProperties.Name="Speaking pace"/><TextBlock Text="Slower                              Faster" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/>
                    <Button Content="Pronunciation settings…" Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="0,10,0,0"/>
                </StackPanel></Border><Border Background="{DynamicResource Tint}" CornerRadius="10" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Your narration queue" FontWeight="SemiBold"/><TextBlock Text="Each saved narration appears in Your library with its current stage, progress and any error. Open an existing item to retry or resume it." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="OUTPUT FOLDER" FontSize="10" FontWeight="SemiBold" Margin="0,20,0,7"/><TextBlock Text="{Binding DestinationDisplay}" TextWrapping="Wrap" FontSize="12"/><Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}" Margin="0,12,0,0"/></StackPanel></Border><TextBlock Text="Keep the laptop awake while generating. Check OneDrive upload before listening on your phone." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="8,18,8,0"/></StackPanel></ScrollViewer>
            </Grid>
            <Grid Grid.Row="2" Visibility="{Binding IsLibrary, Converter={StaticResource BoolVisible}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"/><TextBlock Text="{Binding LibrarySummary}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></DockPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="NarrationList" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" Foreground="{DynamicResource Ink}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Narration library"><ListBox.ItemTemplate><DataTemplate><Border Padding="15,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Submitted}" Style="{StaticResource Caption}" Margin="0,6,0,10"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding ProgressSummary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisible}}" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Tint}"/><ProgressBar Height="3" Value="{Binding Progress, Mode=OneWay}" Maximum="{Binding ChunkTotal}" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Tint}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,14"><TextBlock Text="NARRATION DETAILS" Style="{StaticResource Caption}"/><Button Content="Copy all details" Command="{Binding CopyDetailsCommand}" IsEnabled="{Binding HasSelectedJob}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Copy narration details, error and repair steps"/><TextBox Text="{Binding SelectedJob.ProgressSummary, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Margin="0,10,0,0" AutomationProperties.Name="Retained segment progress" AutomationProperties.LiveSetting="Polite"/></StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                                <TextBox Text="{Binding SelectedJob.Title, Mode=OneWay, TargetNullValue=Select a narration}" Style="{StaticResource SelectableDetails}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.Name="Narration title"/>
                                <TextBox Text="{Binding SelectedJob.Status, Mode=OneWay}" Style="{StaticResource SelectableDetails}" FontWeight="SemiBold" AutomationProperties.Name="Narration status" AutomationProperties.LiveSetting="Polite"/>

                                <TextBox Text="{Binding SelectedJob.Error, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Foreground="{DynamicResource Error}" Margin="0,16,0,0" AutomationProperties.Name="Narration error"/>
                                <StackPanel Visibility="{Binding SelectedJob.HasRecoveryInstructions, Converter={StaticResource BoolVisible}}" Margin="0,18,0,0">
                                    <TextBlock Text="HOW TO FIX" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedJob.RecoveryInstructions, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Margin="0,10,0,0" AutomationProperties.Name="Steps to fix this narration"/>
                                    <TextBox Text="{Binding SelectedSpeechResult, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Margin="0,12,0,0" AutomationProperties.Name="Last speech check for this narration" AutomationProperties.LiveSetting="Polite"/>
                                    <Button Content="Open setup checks" Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="0,14,0,8"/>
                                    <Button Content="Check saved speech service" Command="{Binding SelectedReadinessCommand}" Visibility="{Binding SelectedJob.NeedsSpeechCheck, Converter={StaticResource BoolVisible}}" Margin="0,0,0,8" Padding="8,10" ToolTip="Check the saved narration's engine and reset its recovery allowance"/>
                                    <Button Content="Repair speech &amp; resume" Command="{Binding RepairSelectedCommand}" Visibility="{Binding SelectedJob.NeedsSpeechCheck, Converter={StaticResource BoolVisible}}" Margin="0,0,0,8" ToolTip="Start verified stopped speech services, check the captured model, then resume this existing narration"/>
                                    <Button Content="Retry / resume" Command="{Binding RetryCommand}" Margin="0,0,0,8"/>
                                </StackPanel>
                                <TextBox Text="{Binding SelectedJob.Guidance, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Margin="0,12,0,0" AutomationProperties.Name="Narration guidance"/>
                                <TextBox Text="{Binding SelectedJob.Details, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" AutomationProperties.Name="Narration settings and progress"/>
                                <TextBox Text="{Binding SelectedJob.Delivery, Mode=OneWay}" Style="{StaticResource SelectableDetails}" Margin="0,16,0,0" AutomationProperties.Name="Narration delivery"/>
                                <Button Content="▶  Play local audio" Command="{Binding PlayCommand}" Margin="0,22,0,8"/><Button Content="■  Stop playback" Command="{Binding StopCommand}" Margin="0,0,0,8"/><Button Content="Open exported folder" Command="{Binding OpenFolderCommand}" Margin="0,0,0,8"/><Button Content="Inspect source &amp; preparation" Command="{Binding InspectCommand}" Margin="0,0,0,8"/><Button Content="Retry / resume" Command="{Binding RetryCommand}" Margin="0,12,0,8"/><Button Content="Retry export to another folder…" Command="{Binding ReplaceDestinationCommand}" Margin="0,0,0,8"/><Button Content="Cancel narration" Command="{Binding CancelCommand}" Margin="0,0,0,8"/><Button Content="Move pending job earlier" Command="{Binding MoveEarlierCommand}" Margin="0,0,0,8"/><Button Content="Move pending job later" Command="{Binding MoveLaterCommand}" Margin="0,0,0,8"/><Button Content="Use as a new draft" Command="{Binding ReuseCommand}" Margin="0,0,0,8"/><Button Content="Delete narration…" Command="{Binding DeleteCommand}" Margin="0,16,0,0"/>
                            </StackPanel></ScrollViewer>
                        </Grid>
                    </Border>
                </Grid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="＋  New narration" Command="{Binding NavigateCommand}" CommandParameter="compose"/><Button Content="Delete all managed items…" Command="{Binding DeleteAllCommand}"/></StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettings, Converter={StaticResource BoolVisible}}"><StackPanel MaxWidth="800" HorizontalAlignment="Left">
                <TextBlock Text="A little setup. A simpler commute." Foreground="{DynamicResource Muted}" Margin="0,0,0,24"/><TextBlock Text="Delivery" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Choose an existing corporate OneDrive folder synced to this laptop. Only finished MP3s are written here." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><TextBox Text="{Binding DestinationDisplay, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Output folder"/><StackPanel Orientation="Horizontal" Margin="0,12,0,26"><Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}"/><Button Content="Test write access" Command="{Binding TestFolderCommand}"/></StackPanel>
                <TextBlock Text="Preparation &amp; pronunciation" FontSize="21" FontWeight="SemiBold"/>
                <CheckBox Content="Exclude fenced code blocks from narration" IsChecked="{Binding ExcludeCode}" Margin="0,16,0,10"/>
                <TextBlock Text="Headings and bullets lose their formatting markers. Links retain text and URL. Table cells have column cues. Code symbols are spoken unless fenced code is explicitly excluded." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="{Binding PronunciationCapability}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="Use supported English profile" Command="{Binding ResetPronunciationCommand}" Visibility="{Binding PronunciationUnsupported, Converter={StaticResource BoolVisible}}" HorizontalAlignment="Left"/>
                <StackPanel IsEnabled="{Binding PronunciationSupported}">
                    <Label Content="Numbers" Target="{Binding ElementName=NumberStyleInput}" Padding="0,10,0,7"/>
                    <ComboBox x:Name="NumberStyleInput" ItemsSource="{Binding NumberOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NumberStyle}" AutomationProperties.Name="Number reading"/>
                    <TextBlock Text="Value reading supports integers, comma groups and decimals in English. Fractional and leading-zero digits stay separate. Versions, fractions and times use literal digits and symbols. Scientific reading also interprets e notation." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                    <Label Content="Uppercase words" Target="{Binding ElementName=AcronymStyleInput}" Padding="0,10,0,7"/>
                    <ComboBox x:Name="AcronymStyleInput" ItemsSource="{Binding AcronymOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AcronymStyle}" AutomationProperties.Name="Acronym reading"/>
                    <Label Content="Calendar dates" Target="{Binding ElementName=DateStyleInput}" Padding="0,10,0,7"/>
                    <ComboBox x:Name="DateStyleInput" ItemsSource="{Binding DateOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DateStyle}" AutomationProperties.Name="Calendar date reading"/>
                    <TextBlock Text="Date interpretation is explicit and uses a four-digit year. Invalid dates remain as written and appear as warnings in review. Without calendar interpretation, number options read date digits and symbols." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                    <Label Content="Pronunciation dictionary — term=spoken words, one per line" Target="{Binding ElementName=DictionaryInput}" Padding="0,16,0,7"/>
                    <TextBox x:Name="DictionaryInput" Text="{Binding Pronunciation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Pronunciation dictionary"/>
                </StackPanel>
                <TextBlock Text="Dictionary rules run in order before number, date and uppercase options. Review preparation to inspect the final script and each change. Settings apply to new submissions; existing jobs retain their captured settings." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                <TextBlock Text="Speech recovery" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Start installed Docker Desktop and verified stopped CommuteCast containers, wait for readiness and refresh setup. Running containers are checked without restarting them." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><Button Content="Start / repair speech services" Command="{Binding RepairSpeechCommand}" HorizontalAlignment="Left"/><TextBox Text="{Binding SpeechRepairDetails, Mode=OneWay}" Style="{StaticResource SelectableDetails}" AutomationProperties.Name="Speech repair results" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,24"/>
                <TextBlock Text="Setup check" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Inspect installed tools and local speech without starting, installing or changing anything." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><Button Content="Check setup" Command="{Binding SetupCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding SetupDetails}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="12" Margin="0,12,0,24"/><TextBlock Text="Local speech &amp; tools" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Readiness starts only installed Docker Desktop and verified stopped CommuteCast containers. It never installs software or replaces images." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><Button Content="Check speech readiness &amp; refresh voices" Command="{Binding ReadinessCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ProviderDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,12,0,12"/>
                <Label Content="FFmpeg executable" Target="{Binding ElementName=FfmpegInput}" Padding="0,8,0,7"/><TextBox x:Name="FfmpegInput" Text="{Binding Ffmpeg, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="FFmpeg executable"/><Label Content="FFprobe executable" Target="{Binding ElementName=FfprobeInput}" Padding="0,12,0,7"/><TextBox x:Name="FfprobeInput" Text="{Binding Ffprobe, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="FFprobe executable"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,12"><Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/><Button Content="Check encoder" Command="{Binding CheckEncoderCommand}"/><Button Content="Switch light / dark" Command="{Binding ThemeCommand}"/></StackPanel>
                <TextBlock Text="Storage &amp; privacy" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock Text="{Binding StorageDetails}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
                <WrapPanel Margin="0,0,0,12"><StackPanel Margin="0,0,18,0"><Label Content="Intermediate cache quota (MiB)"/><TextBox Width="200" HorizontalAlignment="Left" Text="{Binding CacheQuotaMiB}" AutomationProperties.Name="Intermediate cache quota in MiB"/></StackPanel><StackPanel Margin="0,0,18,0"><Label Content="Scratch retention (days)"/><TextBox Width="160" HorizontalAlignment="Left" Text="{Binding ScratchRetentionDays}" AutomationProperties.Name="Scratch retention in days"/></StackPanel><StackPanel><Label Content="Private storage budget (MiB)"/><TextBox Width="200" HorizontalAlignment="Left" Text="{Binding PrivateStorageLimitMiB}" AutomationProperties.Name="Private storage budget in MiB"/></StackPanel></WrapPanel>
                <TextBlock Text="Old scratch is cleaned by age; eligible intermediates are cleaned to the quota after each job and before submission. New jobs are refused when their estimated storage exceeds the private budget. Protected data may exceed the cache quota until you delete narrations." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                <WrapPanel Margin="0,0,0,18"><Button Content="Measure usage" Command="{Binding MeasureStorageCommand}"/><Button Content="Clean eligible cache" Command="{Binding CleanCacheCommand}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/></WrapPanel>
                <Button Content="Export redacted diagnostics…" Command="{Binding DiagnosticsCommand}" HorizontalAlignment="Left"/><TextBlock Text="Diagnostics exclude source, script, titles, audio, and corporate paths. Removing a managed export can propagate through OneDrive; tenant retention, recycle bins, and phone copies are outside this app's control." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,22"/>
                <TextBlock Text="Backup &amp; restore" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <TextBlock Text="Stop generation and save this draft before opening private backup and restore controls. Returning reloads local state." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
                <Button Content="Open backup &amp; restore…" Click="OpenMaintenance" HorizontalAlignment="Left" Margin="0,0,0,22"/>
                <TextBlock Text="About · CommuteCast 0.1.0" FontWeight="SemiBold"/><TextBlock Text="WPF / .NET 10 · SQLite · FFmpeg · Kokoro ONNX / Piper. See THIRD-PARTY-NOTICES.md for notices. Voice quality and Android delivery require acceptance on the intended devices." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,18"/>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,12,0,0"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/></Border>
        </Grid>
    </Grid>
</Window>
