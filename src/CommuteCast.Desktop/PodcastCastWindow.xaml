<Window x:Class="CommuteCast.Desktop.PodcastCastWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Podcast cast and formats" Width="960" Height="760" MinWidth="750" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
 </Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Choose the people and the conversation" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Personalities shape the writing prompt. Voices and delivery shape the audio. Saved jobs retain an independent copy." TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/></StackPanel>
  <Button DockPanel.Dock="Bottom" Content="Done" Click="Done" HorizontalAlignment="Right"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="Podcast format"/><ComboBox ItemsSource="{Binding PodcastFormats}" DisplayMemberPath="Name" SelectedItem="{Binding PodcastFormat}" AutomationProperties.Name="Podcast format"/><WrapPanel><Button Content="Apply format" Command="{Binding ApplyFormatCommand}"/><Button Content="Add speaker" Command="{Binding AddSpeakerCommand}"/></WrapPanel>
   <CheckBox Content="Use joint dialogue blocks when the provider supports this cast (requires pace 1.0)" IsChecked="{Binding DialogueMode}" Margin="0,0,0,18"/>
   <ItemsControl ItemsSource="{Binding Cast}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="Personality library"/><ComboBox ItemsSource="{Binding DataContext.SpeakerLibrary, RelativeSource={RelativeSource AncestorType=ItemsControl}}" DisplayMemberPath="Name" SelectedItem="{Binding Personality}" AutomationProperties.Name="Speaker personality"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Speaker name (exact dialogue label)"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Speaker name"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Role"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" AutomationProperties.Name="Speaker role"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Voice in the selected provider"/><ComboBox ItemsSource="{Binding DataContext.Voices, RelativeSource={RelativeSource AncestorType=ItemsControl}}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Voice}" AutomationProperties.Name="Speaker voice"/></StackPanel>
     </Grid>
     <TextBlock Text="Areas of expertise"/><TextBox Text="{Binding Expertise, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" AutomationProperties.Name="Speaker expertise"/>
     <TextBlock Text="Speaking personality"/><TextBox Text="{Binding Style, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" AutomationProperties.Name="Speaking personality style"/>
     <StackPanel Visibility="{Binding DataContext.SupportsDelivery, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}"><TextBlock Text="Voice delivery instructions"/><TextBox Text="{Binding Delivery, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" TextWrapping="Wrap" AutomationProperties.Name="Speaker delivery instructions"/></StackPanel>
     <StackPanel Visibility="{Binding DataContext.SupportsEmotion, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}"><TextBlock Text="Delivery emotion"/><ComboBox ItemsSource="{Binding DataContext.Emotions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding Emotion}" AutomationProperties.Name="Speaker emotion"/></StackPanel>
     <WrapPanel><TextBlock Text="Pace" VerticalAlignment="Center"/><TextBox Text="{Binding Speed}" Width="70" AutomationProperties.Name="Speaker pace"/><Button Content="Play voice sample" Command="{Binding DataContext.AuditionSpeakerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><Button Content="Save personality" Command="{Binding DataContext.SavePersonalityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><Button Content="Remove library personality" Command="{Binding DataContext.RemovePersonalityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><Button Content="Remove speaker" Command="{Binding DataContext.RemoveSpeakerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></WrapPanel>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Expander Header="Create or replace a format"><StackPanel Margin="0,12,0,0"><TextBlock Text="Format name"/><TextBox Text="{Binding FormatName}" MaxLength="100"/><WrapPanel><StackPanel><TextBlock Text="Hosts"/><TextBox Text="{Binding FormatHosts}" Width="100"/></StackPanel><StackPanel><TextBlock Text="Minimum guests"/><TextBox Text="{Binding FormatMinimumGuests}" Width="140"/></StackPanel><StackPanel><TextBlock Text="Maximum guests"/><TextBox Text="{Binding FormatMaximumGuests}" Width="140"/></StackPanel></WrapPanel><TextBlock Text="Discussion structure"/><TextBox Text="{Binding FormatStructure}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/><WrapPanel><Button Content="Save format" Command="{Binding SaveFormatCommand}"/><Button Content="Remove selected format" Command="{Binding RemoveFormatCommand}"/></WrapPanel></StackPanel></Expander>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
