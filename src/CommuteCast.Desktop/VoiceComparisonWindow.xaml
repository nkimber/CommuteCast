<Window x:Class="CommuteCast.Desktop.VoiceComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Compare local voices with your script" Width="1000" Height="800" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
 </Window.Resources>
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Find a narrator you enjoy listening to" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Compare your own words with different local voices, blends, pace and delivery. Start with model defaults, then try small changes." TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding StatusMessage}" MaxHeight="65" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><WrapPanel><Button Content="Stop rendering / playback" Command="{Binding StopCommand}"/><Button Content="Start a new comparison" Command="{Binding ClearComparisonCommand}"/><Button Content="Done" Click="Done"/></WrapPanel><TextBlock Text="Samples are private and kept for this app session. Closing this window keeps them available; a new comparison or closing CommuteCast removes them." FontSize="12" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel IsEnabled="{Binding ComparisonIdle}">
    <TextBlock Text="1. Choose a passage" FontSize="18" FontWeight="SemiBold"/>
    <WrapPanel IsEnabled="{Binding ComparisonIdle}"><Button Content="Use entire draft" Command="{Binding ComparisonDraftCommand}"/><Button Content="Use selected script text" Command="{Binding ComparisonSelectionCommand}"/></WrapPanel>
    <TextBox Text="{Binding ComparisonPassage, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ComparisonLocked}" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Comparison passage"/>
    <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"/>
    <TextBlock Text="2. Add voice setups" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="These controls also update your narration draft. Added candidates retain their captured setup." TextWrapping="Wrap" FontSize="12" Margin="0,6,0,10"/>
    <Label Content="Local engine"/><ComboBox ItemsSource="{Binding ComparisonEngines}" SelectedItem="{Binding Engine}" AutomationProperties.Name="Comparison local engine"/>
    <Label Content="Voice"/><ComboBox ItemsSource="{Binding Voices}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Voice}" AutomationProperties.Name="Comparison voice"/>
    <Button Content="Refresh installed voices" Command="{Binding RefreshVoicesCommand}"/>
    <TextBlock Text="{Binding SpeedLabel}"/><Slider Minimum="0.7" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Speed}" AutomationProperties.Name="Comparison speaking pace"/>
    <CheckBox Content="Natural phrasing and listening volume" IsChecked="{Binding NaturalPhrasing}" Margin="0,8,0,8"/>
    <Button Content="Use natural delivery defaults" Command="{Binding ResetNaturalDeliveryCommand}"/>
    <StackPanel Visibility="{Binding IsKokoroVoice, Converter={StaticResource Visible}}"><Label Content="Blend with another voice"/><ComboBox ItemsSource="{Binding BlendVoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding BlendVoice}"/><TextBlock Text="{Binding BlendLabel}"/><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BlendWeight}" AutomationProperties.Name="Comparison blend weight"/></StackPanel>
    <StackPanel Visibility="{Binding IsPiperVoice, Converter={StaticResource Visible}}"><CheckBox Content="Tune Piper variation (unchecked uses model defaults)" IsChecked="{Binding TunePiperVariation}"/><StackPanel IsEnabled="{Binding TunePiperVariation}"><TextBlock Text="Sound variation"/><Slider Minimum="0" Maximum="1.5" Value="{Binding PiperNoiseScale}"/><TextBlock Text="Timing variation"/><Slider Minimum="0" Maximum="1.5" Value="{Binding PiperNoiseWidth}"/></StackPanel><TextBlock Text="{Binding PiperVariationLabel}"/></StackPanel>
    <Expander Header="Pauses at generated segment boundaries"><StackPanel IsEnabled="{Binding NaturalPhrasing}" Margin="0,8,0,0"><TextBlock Text="{Binding LocalPauseLabel}"/><TextBlock Text="Sentence pause"/><Slider Minimum="0" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding SentencePauseMs}"/><TextBlock Text="Paragraph pause"/><Slider Minimum="0" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding ParagraphPauseMs}"/><TextBlock Text="Longer pauses already produced by the model remain intact." FontSize="12" TextWrapping="Wrap"/></StackPanel></Expander>
    <Button Content="Add current voice setup" Command="{Binding AddComparisonCommand}" Margin="0,12,0,8"/>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="3. Render, listen and choose" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Natural samples use the same sentence grouping, joins and final volume matching as your MP3. Preview audio is uncompressed WAV; legacy setups retain their original volume." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"/>
    <ListBox ItemsSource="{Binding ComparisonCandidates}" SelectedItem="{Binding SelectedComparison}" MinHeight="170" MaxHeight="330" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="Voice comparison candidates">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ProgressBar IsIndeterminate="True" Height="5" Margin="0,10,0,6" Visibility="{Binding ComparisonBusy, Converter={StaticResource Visible}}"/>
    <WrapPanel IsEnabled="{Binding ComparisonIdle}"><Button Content="Render selected sample" Command="{Binding RenderComparisonCommand}"/><Button Content="Play selected sample" Command="{Binding PlayComparisonCommand}"/></WrapPanel>
    <TextBlock Text="Listen for natural emphasis, names and numbers, pauses between ideas, and whether the voice becomes tiring. Replay finished clips as often as needed." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16"/>
    <Label Content="Notes for selected sample"/><TextBox Text="{Binding SelectedComparison.Notes, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Comparison listening notes"/>
    <Label Content="Save preferred setup as"/><TextBox Text="{Binding ComparisonPresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Preferred voice preset name"/>
    <Button Content="Save selected setup and use for this draft" Command="{Binding SaveComparisonCommand}" IsEnabled="{Binding ComparisonIdle}"/>
    <TextBlock Text="The preset retains voice, blend or variation, pace, pauses and pronunciation. Try a longer narration before making it your everyday default." TextWrapping="Wrap" FontSize="12"/>
   </StackPanel>
  </Grid></ScrollViewer>
 </DockPanel>
</Window>
